#!/bin/env sh
set -e

# USAGE: gelli serve - Serve your model with Open AI endpoints
#
# gelli serve [port] [model] [loras...] - Run server with Model and LoRAs
#
# To change port set GELLI_PORT variable

THREADS=${GELLI_THREADS:-2}
PARALLEL=${GELLI_PARALLEL:-1}
CTX_SIZE=${GELLI_CTX_SIZE:-0}
BATCH_SIZE=${GELLI_BATCH_SIZE:-256}
UBATCH_SIZE=${GELLI_UBATCH_SIZE:-$BATCH_SIZE}
OUTPUT_SIZE=${GELLI_OUTPUT_SIZE:-999999}

# Scale context for parallel slots
if [ $PARALLEL -gt 1 ] && [ $CTX_SIZE -gt 0 ]; then
  PARALLEL=$((PARALLEL / 2))
  CTX_SIZE=$((CTX_SIZE * PARALLEL))
fi

PORT=$1

shift || true

MODEL=${1:-${GELLI_MODEL:-$GELLI_DEFAULT}}

shift || true

LORAS=${*:-${GELLI_LORAS:-}}
FLAGS=""

MODEL=$(models $MODEL)
LORAS=$(loras $LORAS)

if [ -n "$LORAS" ]; then
  for lora in $LORAS; do
    FLAGS="$FLAGS --lora /models/$MODEL/$lora.gruf"
  done
fi

llama-server --model "$MODEL" $FLAGS \
  --port "$PORT" \
  --threads $THREADS \
  --parallel $PARALLEL \
  --ctx-size $CTX_SIZE \
  --batch-size $BATCH_SIZE \
  --ubatch-size $UBATCH_SIZE \
  --predict $OUTPUT_SIZE \
  --repeat_penalty 1.2 \
  --gpu-layers 999 \
  --cache-type-k q8_0 \
  --cache-type-v q4_0 \
  --rope-scaling yarn \
  --no-warmup \
  --flash-attn on \
  --min_p 0.07 \
  --top_p 0.97 \
  --top_k 7 \
  --temp 0.8 \
  --jinja \
  --mlock
