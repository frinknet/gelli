#!/bin/env sh
set -e

# USAGE: gelli loras - Manage Low Ranking Adapters
#
# gelli loras [patern]                   - Lists LoRAs matching pattern
# gelli loras list [model] [pattern]     - Lists LoRAs for a model matching patter
# gelli loras import [model] [loras...]  - Import remote or local LoRAs for model
# gelli loras export [model] [loras...]  - Export LoRAs out of internal storage
# gelli loras delete [model] [loras...]  - Delete LoRAs from internal storage
#
# MODEL PATTERNS:
#
#   Use hf:repo:file for HuggingFace LoRAs.
#
#   Only works with .gguf files

MODEL=

parse_hf() {
  spec=${1#hf:}
  repo=$(printf '%s\n' "$spec" | cut -d: -f1)
  file=$(printf '%s\n' "$spec" | cut -s -d: -f2)
  file="${file:-adapter_model.gguf}"
  dest="/model/$MODEL/$(echo "${repo//\//-}-${file}" | sed 's#[:/\]#-#g').gguf"

  [ -f "$dest" ] && { echo "$dest"; return; }

  url="https://huggingface.co/$repo/resolve/main/$file"

  echo "$dest" "$url"
}

parse() {
  case "$1" in
    hf:*) parse_hf "$1" ;;
    *) echo "/models/$MODEL/${1##*/}.gguf" ;;
  esac
}

fetch() {
  dest="$1"
  url="$2"

  [ -f "$dest" ] || curl -so "$dest" "$url" || error FAILED LORA FETCH $url
  [ -f "$dest" ] && basename "${dest%.*}"
}

resolve() {
  for arg in "${@}"; do
    [ "$arg" = "base" ] && continue

    fetch $(parse "$arg") || error MISSING $arg
  done
}

outfile() {
  src="$1"
  dest="/work/${1##*/}"

  mv "$src" "$dest"
}

export() {
  for arg in "$@"; do
    outfile $(parse "$arg") || error MISSING $arg
  done
}

infile() {
  dest="$1"
  src="/work/${1##*/}"

  [ "$src" != "$dest" ] && mv "$src" "$dest"
}

import() {
  for arg in "$@"; do
    infile $(parse "$arg") || error "MISSING $arg"
  done
}

list() {
  cd /model/$MODEL

  glob="${1:-*}"

  for f in $glob; do
    [ "$f" = "base.gguf" ] && continue
    [ -f "$f" ] && printf '%s\n' "${f%.*}"
  done
}

listall() {
  for d in /models; do
    [ -d "$d" ] || continue

    MODEL="${d##*/}"

    echo "${MODEL} LoRAs:"
    list "$MODEL" "$@" | sed "s/^/  /"
    echo
  done
}

delete() {
  cd /models/$MODEL

  glob="${@:-*}"

  for f in "$glob"; do
    file=$(parse "$f")

    [ "$file" = "base.gguf" ] && continue

    read -p "Remove '${file%.gguf}'? [Y/n]" -n 1 res

    if [[ "$res" =~ ^[Yy]?$ ]]; then
      rm "$file" || error "FAILED TO REMOVE ${f%.gguf}"
    fi
  done
}

error() {
  echo $@ >&2

  exit 1
}

CMD="$1"

shift

MODEL="${1%.gguf}"
MODEL="${MODEL%/base}"
MODEL="${MODEL##*/}"

shift

case "$CMD" in
  "") listall "$MODEL" "$@";;
  list) list "$@";;
  delete) delete "$@";;
  import) import "$@";;
  export) export "$@";;
  resolve) resolve "$@";;
  *) eval "$BIN-help loras";;
esac
